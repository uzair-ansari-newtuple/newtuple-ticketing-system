# State Machine: the only data store (tickets, photos, users, product catalog)
SM_BASE_URL=
SM_MACHINE_NAME=workflow_dguyp0t8_9f7jus
SM_ENTITY_TYPE=incident
SM_CATALOG_MACHINE_NAME=workflow_xdcauuj7_hnd6zp

# Service account the app uses to read and write the State Machine
SM_EMAIL=
SM_PASSWORD=

# Connectors: the key the State Machine sends to /api/sm/*, and where its worker reaches this backend
SM_CONNECTOR_KEY=
SM_CONNECTOR_BASE_URL=http://host.docker.internal:3001

# true when the workflow is published in step mode (tickets wait for a click at each state)
SM_STEP_MODE=true

# Local test logins, used by the scripts in scripts/ only. Do not set these in a deployed environment.
DEMO_STORE_EMAIL=
DEMO_STORE_PASSWORD=
DEMO_RESOLVER_EMAIL=
DEMO_RESOLVER_PASSWORD=

# DC QC workflows, written by scripts/sm-qc.mjs
SM_QC_PO_MACHINE_NAME=workflow_rwwrhtt9_ozj7v1
SM_QC_LINE_MACHINE_NAME=workflow_d1sypkdp_stg9mc
SM_QC_PALLET_MACHINE_NAME=workflow_p6zh6gv4_sgjmey
