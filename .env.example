# Long random string used to sign login tokens
AUTH_SECRET=

# State Machine mirror (optional). Leave SM_BASE_URL empty to run without it.
SM_BASE_URL=
SM_EMAIL=
SM_PASSWORD=
SM_MACHINE_NAME=workflow_dguyp0t8_9f7jus
SM_ENTITY_TYPE=incident

# Shared key the State Machine connectors send to /api/sm/*
SM_CONNECTOR_KEY=

# Where the State Machine worker reaches the backend (connectors)
SM_CONNECTOR_BASE_URL=http://host.docker.internal:3001

# true when the workflow is published in step mode (tickets wait for a click at each state)
SM_STEP_MODE=false
SM_CATALOG_MACHINE_NAME=workflow_xdcauuj7_hnd6zp
